# ==============================================================================
# CODE-A-NOVA HACKATHON PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and provide your actual production/staging credentials.
# NEVER commit real secret keys, credentials, or production tokens to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5006
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/code_a_nova?retryWrites=true&w=majority
FRONTEND_URL=https://hackathon.example.com

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# High-entropy JWT secret key (minimum 32 characters) used to sign admin & editorial sessions
JWT_SECRET=your_long_random_jwt_secret_key_minimum_32_chars
CRON_SECRET=your_secure_random_cron_worker_secret_key
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 3. RAZORPAY PAYMENT GATEWAY (PHASE 4 PAYMENT WORKFLOW)
# ------------------------------------------------------------------------------
# Live or Test Razorpay API credentials for ₹49 participation verification
RAZORPAY_KEY_ID=rzp_live_exampleKeyId123456
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Webhook secret configured in Razorpay Dashboard for signature validation (HMAC-SHA256)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 4. EMAIL DISPATCH & NOTIFICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Hostinger Primary SMTP Server Configuration
# NOTE: SMTP_USER is used strictly for SMTP server authentication (Hostinger primary mailbox).
# SMTP_FROM and SMTP_REPLY_TO are the public-facing sender and reply addresses displayed to users.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hr@code-a-nova.online
SMTP_PASS=your_hostinger_mailbox_password_here
SMTP_FROM=manager@code-a-nova.online
SMTP_REPLY_TO=manager@code-a-nova.online
SUPPORT_EMAIL=manager@code-a-nova.online

# Resend API Key (for transactional email dispatch & tracking)
RESEND_API_KEY=re_example_api_key_for_transactional_email

# Optional Fallback SMTP / Gmail App Passwords
EMAIL_USER=notifications@example.com
EMAIL_APP_PASSWORD=your_gmail_or_custom_app_password
EMAIL_USER_2=
EMAIL_APP_PASSWORD_2=
MAIL_API_KEY=

# ------------------------------------------------------------------------------
# 5. WHATSAPP ACCESS & COMMUNITY INTEGRATION
# ------------------------------------------------------------------------------
# Official WhatsApp Cloud API / Service integration for confirmed team invitations
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id
WHATSAPP_TOKEN=your_whatsapp_bearer_token
WHATSAPP_SERVICE_URL=https://graph.facebook.com/v19.0
WHATSAPP_API_KEY=

# ------------------------------------------------------------------------------
# 6. ASSET & CLOUD STORAGE (CLOUDINARY)
# ------------------------------------------------------------------------------
# Used for storing team PPT submissions, sponsor logos, and generated certificate templates
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 7. AI SERVICES & EXTERNAL APIS (OPTIONAL)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
RAPIDAPI_KEY=
RAPIDAPI_HOST=
